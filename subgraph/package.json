{
  "name": "ilrm-subgraph",
  "version": "0.2.0-alpha",
  "private": true,
  "description": "TheGraph subgraph for NatLangChain ILRM Protocol",
  "repository": {
    "type": "git",
    "url": "https://github.com/kase1111-hash/ILR-module.git"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.18.1"
  },
  "scripts": {
    "sync-abis": "node scripts/sync-abis.js",
    "check-abis": "node scripts/sync-abis.js --check",
    "codegen": "graph codegen",
    "build": "graph build",
    "test": "graph test -v 0.6.0",
    "deploy": "graph deploy --node https://api.studio.thegraph.com/deploy/ ilrm-subgraph",
    "create-local": "graph create --node http://localhost:8020/ ilrm-subgraph",
    "remove-local": "graph remove --node http://localhost:8020/ ilrm-subgraph",
    "deploy-local": "graph deploy --node http://localhost:8020/ --ipfs http://localhost:5001 ilrm-subgraph"
  },
  "dependencies": {
    "@graphprotocol/graph-cli": "0.98.1",
    "@graphprotocol/graph-ts": "0.38.2"
  },
  "devDependencies": {
    "matchstick-as": "0.6.0"
  }
}
